local BulletTPGroup = Tabs.Rage:AddLeftGroupbox('Bullet Tp')

-- Lightweight Bullet TP (Camlock-driven). No per-frame freezes.
_G.BulletTPEnabled = false
_G.TargetPlayer = nil
local BTP = {
    ready = false,
    hl = nil,
    toolConn = nil,
    charConn = nil,
    stepConn = nil,
    oldIndex = nil,
}

local function BTP_ClearHighlight()
    if BTP.hl then
        pcall(function() BTP.hl:Destroy() end)
        BTP.hl = nil
    end
end

local function BTP_SetHighlight(target)
    if not target or not target.Character then
        BTP_ClearHighlight()
        return
    end
    if BTP.hl and BTP.hl.Parent and BTP.hl.Adornee == target.Character then
        return
    end
    BTP_ClearHighlight()
    local hl = Instance.new("Highlight")
    hl.Name = "Prestige_BTP"
    hl.FillColor = Color3.fromRGB(255, 255, 255)
    hl.OutlineColor = Color3.fromRGB(0, 0, 0)
    hl.FillTransparency = 0.45
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = target.Character
    pcall(function()
        hl.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)
    BTP.hl = hl
end

local function BTP_BindTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    if BTP.toolConn then
        pcall(function() BTP.toolConn:Disconnect() end)
        BTP.toolConn = nil
    end
    BTP.toolConn = tool.Activated:Connect(function()
        if not Settings.BulletTP or not _G.BulletTPEnabled then return end
        local target = _G.TargetPlayer
        if not (target and target.Character) then return end
        local tp = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
        local hand = player.Character and (player.Character:FindFirstChild("RightHand") or player.Character:FindFirstChild("Right Arm"))
        if not (tp and hand) then return end
        local ok, err = pcall(function()
            local g = tool.Grip
            tool.Parent = player.Backpack
            local offset = hand.CFrame:ToObjectSpace(tp.CFrame)
            -- simple grip aim without inverse heavy math every time
            tool.Grip = CFrame.new(0, -1, 0) * offset
            tool.Parent = player.Character
            task.wait()
            tool.Parent = player.Backpack
            tool.Grip = g
            tool.Parent = player.Character
        end)
    end)
end

local function BTP_OnCharacter(char)
    if not char then return end
    -- only bind equipped tool; do NOT scan getconnections (that freezes)
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then BTP_BindTool(equipped) end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            BTP_BindTool(child)
        end
    end)
end

local function SetupBulletTPHooks()
    if BTP.ready then return end
    BTP.ready = true

    local mouse = player:GetMouse()

    -- mouse hit redirect (cheap)
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldIndex = mt.__index
    BTP.oldIndex = oldIndex
    mt.__index = newcclosure(function(self, i)
        if Settings.BulletTP and _G.BulletTPEnabled and not checkcaller() and self == mouse then
            if i == "Hit" or (i == "Target" and game.PlaceId == 2788229376) then
                local t = _G.TargetPlayer
                if t and t.Character then
                    local p = t.Character:FindFirstChild("Head") or t.Character:FindFirstChild("HumanoidRootPart")
                    if p then return CFrame.new(p.Position) end
                end
            end
        end
        return oldIndex(self, i)
    end)
    setreadonly(mt, true)

    -- throttle highlight / target sync (NOT every frame heavy work)
    local acc = 0
    BTP.stepConn = RunService.Heartbeat:Connect(function(dt)
        if not Settings.BulletTP then
            _G.BulletTPEnabled = false
            _G.TargetPlayer = nil
            BTP_ClearHighlight()
            return
        end
        acc += dt
        if acc < 0.1 then return end -- 10Hz
        acc = 0
        if Locked and Victim and Victim.Character and Victim.Character:FindFirstChild("HumanoidRootPart") then
            _G.TargetPlayer = Victim
            _G.BulletTPEnabled = true
            BTP_SetHighlight(Victim)
        else
            _G.TargetPlayer = nil
            _G.BulletTPEnabled = false
            BTP_ClearHighlight()
        end
    end)

    if player.Character then BTP_OnCharacter(player.Character) end
    if BTP.charConn then BTP.charConn:Disconnect() end
    BTP.charConn = player.CharacterAdded:Connect(function(char)
        task.wait(0.15)
        BTP_OnCharacter(char)
    end)
end

BulletTPGroup:AddToggle('EnableBulletTP', {
    Text = 'Bullet TP',
    Default = false,
    Callback = function(Value)
        Settings.BulletTP = Value
        if Value then
            SetupBulletTPHooks()
            if Locked and Victim then
                _G.TargetPlayer = Victim
                _G.BulletTPEnabled = true
                BTP_SetHighlight(Victim)
            end
            if Settings.Notifications then
                NotificationSystem:Notify("Bullet TP: ON", 2)
            end
        else
            _G.BulletTPEnabled = false
            _G.TargetPlayer = nil
            BTP_ClearHighlight()
        end
    end
})


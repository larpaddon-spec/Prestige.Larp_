task.spawn(function()
    local frames = {}
    while true do
        local now = tick()
        table.insert(frames, now)
        while frames[1] and now - frames[1] > 1 do table.remove(frames, 1) end
        local fps = #frames
        local lockTxt = (Locked and Victim) and (' | ' .. Victim.Name) or ''
        pcall(function()
            Library:SetWatermark(string.format('Prestige.Larp | %s | fps: %d%s', CachedGameName or 'Game', fps, lockTxt))
        end)
        task.wait(0.2)
    end
end)

do
    local menuGui = Instance.new("ScreenGui")
    menuGui.Name = "Prestige_menu_toggle"
    menuGui.ResetOnSpawn = false
    menuGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function() menuGui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not menuGui.Parent then menuGui.Parent = player:WaitForChild("PlayerGui") end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 64, 0, 64)
    frame.Position = UDim2.new(0, 20, 0.5, -32)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.25
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = menuGui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(45, 45, 48)
    stroke.Thickness = 1.5
    local btn = Instance.new("ImageButton")
    btn.Size = UDim2.new(0, 52, 0, 52)
    btn.Position = UDim2.new(0.5, -26, 0.5, -26)
    btn.BackgroundTransparency = 1
    btn.Image = "rbxassetid://105688552585437"
    btn.Parent = frame
    local dragging, dragStart, startPos, dragMoved = false, nil, nil, false
    local function toggleMenu() pcall(function() Library:Toggle() end) end
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragMoved = true, false
            dragStart, startPos = input.Position, frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    if dragging and not dragMoved then toggleMenu() end
                    dragging = false
                end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 6 or math.abs(delta.Y) > 6 then dragMoved = true end
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    btn.MouseButton1Click:Connect(function()
        if not dragMoved then toggleMenu() end
    end)
end

